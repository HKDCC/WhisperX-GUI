# 下列包是打包机 site-packages 里被 PyInstaller 钩子顺带收进来的，运行期用不到。
EXCLUDES = [
    "torch",
    "torchaudio",
    "torchvision",
    "transformers",
    "tokenizers",
    "scipy",
    "sklearn",
    "pandas",
    "matplotlib",
    "plotly",
    "nltk",
    "onnxruntime",
    "av",
    "openai",
    "mcp",
    "uvicorn",
    "starlette",
    "fastapi",
    "paramiko",
    "cryptography",
    "opentelemetry",
    "opentelemetry_sdk",
    "grpc",
    "google",
    "sqlalchemy",
    "win32com",
    "win32",
    "pythoncom",
    "lightning",
    "optuna",
    "safetensors",
    "huggingface_hub",
    "hf_xet",
    "pydantic",
    "pydantic_core",
    "aiohttp",
    "yaml",
    "Crypto",
    "nacl",
    "jsonschema",
    "bs4",
    "lxml",
    "rich",
    "tqdm",
    "invoke",
    "pyreadline3",
]

a = Analysis(
    ['main.py'],
    pathex=[],
    binaries=[],
    datas=[('ui/assets', 'ui/assets')],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=EXCLUDES,
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='WhisperX_GUI',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=os.path.join('ui', 'assets', 'icon.ico'),
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name='WhisperX_GUI',
)
